{
    "manifest_version": 3,
    "name": "YouTube Music Party",
    "version": "1.8.1",
    "description": "Connect a YouTube Music tab to a Telegram-controlled room for shared playback.",
    "host_permissions": ["https://music.youtube.com/*"],
    "icons": {
        "16": "app-icon.png",
        "32": "app-icon.png",
        "48": "app-icon.png",
        "128": "app-icon.png"
    },
    "action": {
        "default_popup": "index.html",
        "default_icon": {
            "16": "app-icon.png",
            "32": "app-icon.png",
            "48": "app-icon.png",
            "128": "app-icon.png"
        }
    },
    "content_scripts": [
        {
            "matches": ["https://music.youtube.com/*"],
            "js": ["content.js"],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": ["https://music.youtube.com/*"],
            "js": ["content-bridge.js"],
            "run_at": "document_start",
            "world": "ISOLATED"
        }
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "telegram-music-party@dhoniaridho.com",
            "strict_min_version": "58.0"
        }
    }
}
