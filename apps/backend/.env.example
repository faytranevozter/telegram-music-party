TELEGRAM_BOT_TOKEN=
DATABASE_PROVIDER=postgresql
# SQLite: DATABASE_PROVIDER=sqlite and DATABASE_URL="file:./dev.db"
# Relative SQLite paths resolve from prisma/sqlite/, not the working directory.
DATABASE_URL="postgresql://user:password@localhost:5432/telegram_music_party?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=3000
# Raw request/playback analytics retention in days; 0 disables pruning.
ANALYTICS_RETENTION_DAYS=365
# Private search opt-in; never place real secrets in this file.
YTMUSIC_SEARCH_ENABLED=false
YTMUSIC_SEARCH_URL=https://telegram-music-party-search.vercel.app/api/search
YTMUSIC_SEARCH_TOKEN=
YTMUSIC_SEARCH_BYPASS_SECRET=
# Total backend request deadline including response body (100–15000 ms).
YTMUSIC_SEARCH_TIMEOUT_MS=8000
